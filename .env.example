# Copy to .env and adjust. Never commit real secrets: .env is gitignored.
# Every variable is read by backend/app/config.py (Settings). Keep this file in sync with it.

# local | test | staging | production
APP_ENV=local
LOG_LEVEL=INFO

# Async SQLAlchemy URL (asyncpg driver). Local credentials match docker-compose.yml and scripts/setup-sandbox.sh.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# Optional. Tests use this database; by default it is DATABASE_URL with the "_test" suffix on the db name.
# The test database is dropped and recreated on every pytest run.
# TEST_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app_test

# Comma-separated list of origins allowed by CORS (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# Frontend (read by Vite at build time, must start with VITE_). Empty = same origin (dev proxy / nginx).
VITE_API_BASE_URL=
